{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colophon-claims.github.io/locomo-judge-report/prompted-screening-audit-envelope/v1",
  "title": "Recorder-composed prompted screening audit envelope version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "auditDispatchSha256", "auditInputByteLength", "auditInputSha256", "auditInstructionSha256", "auditInvocationSha256", "capabilityBoundary", "executionMode", "judgmentPrefixSha256", "materialFindings", "modelAlias", "modelRunOccurred", "nonMaterialObservations", "operatorAttestation", "planSha256", "protocol", "rawAuditPayloadSha256", "reasoning", "runId", "schema", "sourceRevision", "taskId", "testOnly", "toolPolicy"],
  "properties": {
    "schema": { "const": "https://colophon-claims.github.io/locomo-judge-report/prompted-screening-audit-envelope/v1" },
    "protocol": { "const": "prompted-codex-screening-audit-envelope/v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$" },
    "planSha256": { "$ref": "#/$defs/digest" },
    "judgmentPrefixSha256": { "$ref": "#/$defs/digest" },
    "sourceRevision": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "const": "TEST_ONLY_UNCOMMITTED_V7_SOURCE" }] },
    "auditInstructionSha256": { "$ref": "#/$defs/digest" },
    "auditInputSha256": { "$ref": "#/$defs/digest" },
    "auditInputByteLength": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "auditInvocationSha256": { "$ref": "#/$defs/digest" },
    "auditDispatchSha256": { "$ref": "#/$defs/digest" },
    "rawAuditPayloadSha256": { "$ref": "#/$defs/digest" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]{7,191}$" },
    "modelAlias": { "const": "gpt-5.6-sol" },
    "reasoning": { "const": "high" },
    "toolPolicy": { "const": "none" },
    "executionMode": { "enum": ["production-recording", "test-only-simulation"] },
    "testOnly": { "type": "boolean" },
    "modelRunOccurred": { "type": "boolean" },
    "operatorAttestation": { "$ref": "prompted-screening-judgment-prefix.v2.schema.json#/$defs/operatorAttestation" },
    "assessment": { "enum": ["PASS", "FAIL", "REFUSE"] },
    "materialFindings": { "$ref": "prompted-screening-audit-findings.v1.schema.json#/properties/materialFindings" },
    "nonMaterialObservations": { "$ref": "prompted-screening-audit-findings.v1.schema.json#/properties/nonMaterialObservations" },
    "capabilityBoundary": { "$ref": "#/$defs/capabilityBoundary" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capabilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absenceOfBoundaryProofIsProcessDefect", "clearSyntheticFixturePerfectAgreementIsMaterial", "independentGeneration", "invariantModelWeights", "modelRouting", "processFreshness", "promptCompliance", "providerExecution"],
      "properties": {
        "providerExecution": { "const": "not-machine-verified" },
        "processFreshness": { "const": "not-machine-verified" },
        "independentGeneration": { "const": "not-machine-verified" },
        "modelRouting": { "const": "not-machine-verified" },
        "promptCompliance": { "const": "not-machine-verified" },
        "invariantModelWeights": { "const": "not-machine-verified" },
        "absenceOfBoundaryProofIsProcessDefect": { "const": false },
        "clearSyntheticFixturePerfectAgreementIsMaterial": { "const": false }
      }
    }
  }
}
